func is_prime(n: i32) -> bool {
  if (n < 2) return F;
  if (n == 2 | n == 3) return T;
  if (n % 2 == 0) return F;

  i: i32 = 3;
  while (i <= n / i) {
    if (n % i == 0) {
      return F;
    }
    i += 1;
  }

  return T;
}

i: i32 = 0;

@export("number")
n: i32 = 0;

p: func(i32) -> bool = is_prime;
q: &func(i32) -> bool = &p;

while (i < 500) {
  if ((q&)(i)) {
    n += 1;
  }
  i += 1;
}
